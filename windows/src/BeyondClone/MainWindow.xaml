<Window x:Class="BeyondClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeyondClone" Width="1520" Height="920" MinWidth="1100" MinHeight="640"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Barra laterale -->
        <DataTemplate x:Key="SidebarTemplate">
            <Grid>
                <TextBlock Text="{Binding Title}" Visibility="{Binding HeaderVisibility}" Style="{StaticResource SectionHeader}" Margin="0" />
                <Grid Visibility="{Binding ItemVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="6" Background="{Binding GlyphBack}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{Binding GlyphBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{Binding SubtitleBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SubtitleVisibility}" />
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border CornerRadius="8" Padding="6,1" Background="{Binding BadgeBack}" Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <ProgressBar Width="34" Height="5" Minimum="0" Maximum="1" Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding Indeterminate}" Visibility="{Binding ProgressVisibility}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="420" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="310" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Barra laterale ===================== -->
        <DockPanel Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="6">
                <DockPanel>
                    <Button x:Name="AddButton" Style="{StaticResource IconButton}" Content="&#xE710;" Click="Add_Click"
                            ToolTip="Nuovo profilo di sincronizzazione, nuovo confronto o connessione al server" />
                    <Button x:Name="SyncAllButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="SyncAll_Click" Padding="10,4"
                            ToolTip="Analizza tutti i profili con la loro modalità e sincronizzali insieme, in parallelo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Sincronizza tutti" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
            <ListBox x:Name="SidebarList" BorderThickness="0" Background="Transparent" Padding="0,6,0,6"
                     ItemContainerStyle="{StaticResource SidebarItem}" ItemTemplate="{StaticResource SidebarTemplate}"
                     SelectionChanged="Sidebar_SelectionChanged" ContextMenuOpening="Sidebar_ContextMenuOpening"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu />
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"
                      ToolTip="Trascina per allargare o restringere la barra laterale" />

        <!-- ===================== Benvenuto ===================== -->
        <ScrollViewer x:Name="WelcomePanel" Grid.Column="2" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Width="700">
                <Image Source="Assets/icon.png" Width="112" Height="112" />
                <TextBlock Text="BeyondClone" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Confronta, sincronizza e specchia cartelle, sul PC e sul NAS." Style="{StaticResource Caption}" FontSize="14"
                           HorizontalAlignment="Center" />
                <UniformGrid Columns="3" Margin="0,24,0,0">
                    <Button x:Name="WelcomeCompare" Margin="6" Padding="16" HorizontalContentAlignment="Left" Click="NewCompare_Click"
                            ToolTip="Scegli due cartelle e guarda subito le differenze">
                        <StackPanel>
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Confronto al volo" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="Due cartelle, differenze subito." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6" Padding="16" HorizontalContentAlignment="Left" Click="NewProfile_Click"
                            ToolTip="Una coppia di cartelle salvata, da rieseguire quando vuoi">
                        <StackPanel>
                            <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Profilo di sincronizzazione" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="Coppia salvata, da rieseguire." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6" Padding="16" HorizontalContentAlignment="Left" Click="Connect_Click"
                            ToolTip="Collega una condivisione del NAS (SMB) con le credenziali di Windows">
                        <StackPanel>
                            <TextBlock Text="&#xE968;" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Connetti il NAS" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="Condivisione SMB." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <TextBlock x:Name="WelcomeRecentsTitle" Text="Confronti recenti" FontWeight="SemiBold" Margin="6,24,0,6" />
                <StackPanel x:Name="WelcomeRecents" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Area di lavoro ===================== -->
        <DockPanel x:Name="WorkspacePanel" Grid.Column="2" Visibility="Collapsed">
            <!-- Barra dei comandi -->
            <Border DockPanel.Dock="Top" Padding="14,8,10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Click="ExpandAll_Click" ToolTip="Espandi tutte le cartelle" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Click="CollapseAll_Click" ToolTip="Comprimi tutte le cartelle" />
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="Rianalizza le due cartelle (F5)" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE9E9;" Click="Options_Click" ToolTip="Opzioni di confronto e sincronizzazione" />
                        <Button x:Name="SaveProfileButton" Style="{StaticResource IconButton}" Content="&#xE734;" Click="SaveProfile_Click"
                                ToolTip="Salva questa coppia come profilo di sincronizzazione" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8AB;" Click="Swap_Click" ToolTip="Scambia sinistra e destra" />
                        <Grid Width="200" Margin="8,0">
                            <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="Search_TextChanged" Padding="28,5,8,5"
                                     ToolTip="Filtra per nome: mostra solo gli elementi che contengono il testo (Ctrl+F)" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Left" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchHint" Text="Filtra per nome" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <Button x:Name="SyncButton" Click="Sync_Click" Padding="14,5" Style="{StaticResource {x:Type Button}}"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="White" Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Sincronizza…" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="InspectorToggle" Style="{StaticResource IconToggle}" Content="&#xE8A0;" IsChecked="True"
                                      Click="InspectorToggle_Click" ToolTip="Mostra o nascondi il pannello dei dettagli" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Schede delle due cartelle -->
            <Grid DockPanel.Dock="Top" Margin="12,10,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="LeftCard" Style="{StaticResource Card}" AllowDrop="True" Drop="Card_Drop" DragOver="Card_DragOver"
                        MouseLeftButtonDown="Card_MouseDown" Tag="Left" Cursor="Hand" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ModeButton" Width="44" Height="44" Click="Mode_Click" HorizontalAlignment="Center" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="circle" Fill="{TemplateBinding Background}" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="circle" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ModeGlyph" Style="{StaticResource Glyph}" FontSize="18" Foreground="White" />
                    </Button>
                    <TextBlock x:Name="ModeTitle" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock x:Name="ModeSubtitle" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <Border x:Name="RightCard" Grid.Column="2" Style="{StaticResource Card}" AllowDrop="True" Drop="Card_Drop" DragOver="Card_DragOver"
                        MouseLeftButtonDown="Card_MouseDown" Tag="Right" Cursor="Hand" />
            </Grid>

            <!-- Filtri -->
            <Border DockPanel.Dock="Top" Padding="12,6" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <WrapPanel x:Name="FilterPanel" Orientation="Horizontal">
                    <TextBlock Text="Mostra" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                </WrapPanel>
            </Border>

            <!-- Barra di stato -->
            <Border DockPanel.Dock="Bottom" Padding="12,5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <DockPanel x:Name="StatusPanel" MinHeight="24" LastChildFill="True">
                    <Button x:Name="StatusStop" DockPanel.Dock="Right" Content="Ferma" Padding="10,2" Click="Stop_Click" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0" />
                    <ProgressBar x:Name="StatusProgress" Width="200" Height="6" Minimum="0" Maximum="1" Margin="0,0,10,0" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Albero a colonne -->
            <Grid>
                <ListView x:Name="Tree" ItemsSource="{Binding Rows}" SelectionMode="Extended" BorderThickness="0"
                          ItemContainerStyle="{StaticResource DiffRow}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SelectionChanged="Tree_SelectionChanged" MouseDoubleClick="Tree_DoubleClick"
                          PreviewKeyDown="Tree_KeyDown" ContextMenuOpening="Tree_ContextMenuOpening">
                    <ListView.ContextMenu>
                        <ContextMenu />
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Width="340">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Sinistra" HorizontalContentAlignment="Left"
                                                          ToolTip="Elementi della cartella di sinistra. Doppio clic su una cartella per aprirla, su un file per confrontarne il contenuto" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="{Binding Indent}" LastChildFill="True">
                                            <Grid Width="18" DockPanel.Dock="Left">
                                                <Button Content="{Binding ExpanderGlyph}" Tag="{Binding}" Click="Expander_Click" Style="{StaticResource IconButton}"
                                                        Width="18" Height="18" FontSize="9" Visibility="{Binding ExpanderVisibility}" ToolTip="Apri o chiudi la cartella" />
                                            </Grid>
                                            <Image Source="{Binding LeftIcon}" Width="16" Height="16" Margin="2,0,6,0" DockPanel.Dock="Left" />
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,0" Margin="6,0,2,0" Background="{Binding BadgeBack}"
                                                    Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding BadgeBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding LeftName}" Foreground="{Binding LeftBrush}" FontWeight="{Binding NameWeight}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Dimensione" ToolTip="Dimensione del file o, per le cartelle, del loro contenuto" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LeftSize}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Modificato" ToolTip="Data di ultima modifica; in rosso il lato più recente" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LeftDate}" HorizontalAlignment="Right" Foreground="{Binding LeftDateBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="46">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="" ToolTip="Stato: = uguali, ≠ diversi, › ‹ più recente a sinistra o a destra, ◀ ▶ presente da un solo lato, ⋯ in analisi" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="26" Height="18" CornerRadius="5" Background="{Binding StatusBack}" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="340">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Destra" HorizontalContentAlignment="Left" ToolTip="Elementi della cartella di destra" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="{Binding Indent}" LastChildFill="True">
                                            <Grid Width="18" DockPanel.Dock="Left" />
                                            <Image Source="{Binding RightIcon}" Width="16" Height="16" Margin="2,0,6,0" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding RightName}" Foreground="{Binding RightBrush}" FontWeight="{Binding NameWeight}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Dimensione" ToolTip="Dimensione del file o, per le cartelle, del loro contenuto" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RightSize}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Modificato" ToolTip="Data di ultima modifica; in rosso il lato più recente" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RightDate}" HorizontalAlignment="Right" Foreground="{Binding RightDateBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="True">
                    <TextBlock x:Name="OverlayGlyph" Style="{StaticResource Glyph}" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="OverlayTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock x:Name="OverlayText" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" />
                    <ProgressBar x:Name="OverlayProgress" IsIndeterminate="True" Width="160" Margin="0,10,0,0" Visibility="Collapsed" />
                    <Button x:Name="OverlayButton" Content="Riprova" HorizontalAlignment="Center" Margin="0,12,0,0" Click="Refresh_Click" Visibility="Collapsed"
                            ToolTip="Riprova a raggiungere le cartelle e a confrontarle" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ===================== Ispettore ===================== -->
        <Border x:Name="InspectorPanel" Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="InspectorContent" Margin="14" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
